{
  "name": "landlord",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w @landlord/server\" \"npm run dev -w @landlord/client\"",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w @landlord/engine -w @landlord/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
